{
  "name": "@webship.co/workspace-drupal-profiles",
  "version": "1.0.0-alpha1",
  "description": "The Drupal profiles workspace for Webship Workspace: the `profiles/` folder (type sites), its settings file, its 46 commands and its docs, activated as a plugin.",
  "main": "dist/src/index.js",
  "types": "dist/src/index.d.ts",
  "license": "ISC",
  "repository": {
    "type": "git",
    "url": "https://github.com/webship/workspace-drupal-profiles.git"
  },
  "files": [
    "dist/src",
    "commands",
    "config",
    "docs",
    "features",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepare": "npm run build",
    "test": "npm run build && node --test dist/tests/*.test.js",
    "lint": "tsc -p tsconfig.json --noEmit"
  },
  "workspacePlugin": {
    "name": "drupal-profiles",
    "label": "Drupal profiles",
    "workspace": {
      "key": "profiles",
      "settingsTemplate": "config/workspace.profiles.settings.yml",
      "files": [
        "commands/cmd-build-profiles-bear.sh",
        "commands/cmd-build-profiles-commerce.sh",
        "commands/cmd-build-profiles-cucumber.sh",
        "commands/cmd-build-profiles-degov.sh",
        "commands/cmd-build-profiles-droopler.sh",
        "commands/cmd-build-profiles-dropsolid_rocketship.sh",
        "commands/cmd-build-profiles-drupal_demo_umami.sh",
        "commands/cmd-build-profiles-drupal_minimal.sh",
        "commands/cmd-build-profiles-drupal_standard.sh",
        "commands/cmd-build-profiles-drustack.sh",
        "commands/cmd-build-profiles-drutopia.sh",
        "commands/cmd-build-profiles-govcms8.sh",
        "commands/cmd-build-profiles-lightning.sh",
        "commands/cmd-build-profiles-mandatory.sh",
        "commands/cmd-build-profiles-openedu.sh",
        "commands/cmd-build-profiles-openfed.sh",
        "commands/cmd-build-profiles-openlucius.sh",
        "commands/cmd-build-profiles-openrestaurant.sh",
        "commands/cmd-build-profiles-openy.sh",
        "commands/cmd-build-profiles-opigno_lms.sh",
        "commands/cmd-build-profiles-orange_ecom_profile.sh",
        "commands/cmd-build-profiles-panopoly.sh",
        "commands/cmd-build-profiles-paragon.sh",
        "commands/cmd-build-profiles-pino.sh",
        "commands/cmd-build-profiles-presto.sh",
        "commands/cmd-build-profiles-quick_start.sh",
        "commands/cmd-build-profiles-sector.sh",
        "commands/cmd-build-profiles-seeds.sh",
        "commands/cmd-build-profiles-sm_dev_portal.sh",
        "commands/cmd-build-profiles-social.sh",
        "commands/cmd-build-profiles-splashawards.sh",
        "commands/cmd-build-profiles-thunder.sh",
        "commands/cmd-build-profiles-university.sh",
        "commands/cmd-build-profiles-webship.sh",
        "commands/cmd-build-profiles-wxt.sh",
        "commands/cmd-build-profiles.sh",
        "commands/cmd-tools-checks.sh",
        "commands/cmd-tools-clone.sh",
        "commands/cmd-tools-gitlab-ci-local.sh",
        "commands/cmd-tools-graphify.sh",
        "commands/cmd-tools-obsidian.sh",
        "commands/cmd-tools-ragify.sh",
        "commands/cmd-tools-reclaim.sh",
        "commands/cmd-tools-remove.sh",
        "commands/cmd-tools-screen.sh",
        "commands/cmd-tools-update-all.sh"
      ],
      "docs": [
        "docs/AGENTS.md",
        "docs/CLAUDE.md",
        "docs/README.md"
      ]
    },
    "features": [
      "features/drupal-profiles.feature"
    ]
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@webship.co/workspace-plugin-api": "^1.0.0-alpha1",
    "typescript": "^5.9.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
